# 智谱开放平台 API Key (用于路由与函数调用意图识别)
ZHIPUAI_API_KEY="your_zhipuai_api_key_here"

# Moonshot API Key (用于构建 Kimi 大文本 RAG 问答)
MOONSHOT_API_KEY="your_moonshot_api_key_here"

# DeepSeek API Key (Kimi 翻译降级备选)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# ==========================================
# 科大讯飞 API 凭证
# ==========================================

# 1. 语音听写 (流式版) - 用于将麦克风语音转为文字
IFLYTEK_ASR_APP_ID="your_iflytek_asr_app_id"
IFLYTEK_ASR_API_KEY="your_iflytek_asr_api_key"
IFLYTEK_ASR_API_SECRET="your_iflytek_asr_api_secret"

# 2. 在线语音合成 (流式版) - 用于将文字转为语音播报
IFLYTEK_TTS_APP_ID="your_iflytek_tts_app_id"
IFLYTEK_TTS_API_KEY="your_iflytek_tts_api_key"
IFLYTEK_TTS_API_SECRET="your_iflytek_tts_api_secret"

# ==========================================
# JWT 认证密钥 (生产环境必须更换!)
# ==========================================
JWT_SECRET="change-this-to-a-random-string-in-production"

# ==========================================
# 部署配置 (Railway / 生产环境)
# ==========================================

# CORS 白名单 (逗号分隔)
CORS_ALLOWED_ORIGINS="https://your-project.pages.dev,http://localhost:5173"

# CORS 正则匹配 (默认匹配 Vercel + Cloudflare Pages 子域)
# CORS_ALLOW_ORIGIN_REGEX="https://.*\.(vercel\.app|pages\.dev)"
