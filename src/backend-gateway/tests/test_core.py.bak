# -*- coding: utf-8 -*-
"""
ArchTwin Backend Core Tests
Covers: REST API endpoints, Knowledge Graph, Embedding adapter, FAISS retrieval
"""
import os
import sys
import json
import pytest

# Ensure backend is importable
sys.path.insert(0, os.path.dirname(__file__))

from fastapi.testclient import TestClient
from main import app

client = TestClient(app)


# ── Health & Basic Endpoints ─────────────────────────

class TestHealthEndpoints:
    def test_health_check(self):
        r = client.get("/health")
        assert r.status_code == 200
        assert r.json()["status"] == "ok"

    def test_cors_headers(self):
        r = client.options(
            "/health",
            headers={"Origin": "http://localhost:5173", "Access-Control-Request-Method": "GET"}
        )
        assert r.status_code == 200


# ── Catalog API ──────────────────────────────────────

class TestCatalogAPI:
    def test_catalog_returns_all_categories(self):
        r = client.get("/api/v1/catalog")
        assert r.status_code == 200
        data = r.json()
        for key in ["residential", "official", "imperial", "bridge"]:
            assert key in data
            assert "display_name" in data[key]
            assert "available_variants" in data[key]


# ── Knowledge Graph API ──────────────────────────────

class TestKnowledgeGraphAPI:
    def test_kg_returns_nodes_and_edges(self):
        r = client.get("/api/v1/knowledge-graph")
        assert r.status_code == 200
        data = r.json()
        assert "nodes" in data
        assert "edges" in data
        assert "stats" in data

    def test_kg_stats_counts(self):
        r = client.get("/api/v1/knowledge-graph/stats")
        assert r.status_code == 200
        stats = r.json()
        assert stats["node_count"] >= 100
        assert stats["edge_count"] >= 100
        assert len(stats["groups"]) >= 10

    def test_kg_node_structure(self):
        r = client.get("/api/v1/knowledge-graph")
        data = r.json()
        node = data["nodes"][0]
        assert "id" in node
        assert "label" in node
        assert "group" in node

    def test_kg_edge_structure(self):
        r = client.get("/api/v1/knowledge-graph")
        data = r.json()
        edge = data["edges"][0]
        assert "id" in edge
        assert "from" in edge
        assert "to" in edge
        assert "label" in edge

    def test_kg_root_node_exists(self):
        r = client.get("/api/v1/knowledge-graph")
        node_ids = [n["id"] for n in r.json()["nodes"]]
        assert "yingzao" in node_ids

    def test_kg_all_edges_reference_valid_nodes(self):
        r = client.get("/api/v1/knowledge-graph")
        data = r.json()
        node_ids = {n["id"] for n in data["nodes"]}
        for edge in data["edges"]:
            assert edge["from"] in node_ids, f"Edge {edge['id']} references unknown source {edge['from']}"
            assert edge["to"] in node_ids, f"Edge {edge['id']} references unknown target {edge['to']}"


# ── Embedding Adapter ────────────────────────────────

class TestEmbeddingAdapter:
    def test_embed_query_returns_correct_dim(self):
        from core.embeddings import ArchTwinEmbeddings
        emb = ArchTwinEmbeddings(cache_dir=".embedding_cache_test")
        vec = emb.embed_query("test text")
        assert len(vec) == 384

    def test_embed_documents_batch(self):
        from core.embeddings import ArchTwinEmbeddings
        emb = ArchTwinEmbeddings(cache_dir=".embedding_cache_test")
        vecs = emb.embed_documents(["text one", "text two", "text three"])
        assert len(vecs) == 3
        assert all(len(v) == 384 for v in vecs)

    def test_embed_cache_consistency(self):
        from core.embeddings import ArchTwinEmbeddings
        emb = ArchTwinEmbeddings(cache_dir=".embedding_cache_test")
        v1 = emb.embed_query("cache test string")
        v2 = emb.embed_query("cache test string")
        assert v1 == v2

    def test_embed_different_texts_differ(self):
        from core.embeddings import ArchTwinEmbeddings
        emb = ArchTwinEmbeddings(cache_dir=".embedding_cache_test")
        v1 = emb.embed_query("ancient architecture")
        v2 = emb.embed_query("modern skyscraper")
        assert v1 != v2

    def test_embed_normalized(self):
        import math
        from core.embeddings import ArchTwinEmbeddings
        emb = ArchTwinEmbeddings(cache_dir=".embedding_cache_test")
        vec = emb.embed_query("normalization test")
        norm = math.sqrt(sum(x * x for x in vec))
        assert abs(norm - 1.0) < 0.01


# ── FAISS Retrieval ──────────────────────────────────

class TestFAISSRetrieval:
    @pytest.fixture(autouse=True)
    def setup(self):
        self.db_path = os.path.join(os.path.dirname(__file__), "..", "faiss_db")
        self.has_index = os.path.exists(os.path.join(self.db_path, "index.faiss"))

    def test_faiss_index_exists(self):
        assert self.has_index, "FAISS index not found at faiss_db/"

    @pytest.mark.skipif(
        not os.path.exists(os.path.join(os.path.dirname(__file__), "..", "faiss_db", "index.faiss")),
        reason="FAISS index not built"
    )
    def test_faiss_retrieval_returns_results(self):
        import pickle
        import numpy as np
        import faiss
        from langchain_community.vectorstores import FAISS as FAISSStore
        from core.embeddings import ArchTwinEmbeddings

        emb = ArchTwinEmbeddings(cache_dir=".embedding_cache_test")
        with open(os.path.join(self.db_path, "index.faiss"), "rb") as f:
            index = faiss.deserialize_index(np.frombuffer(f.read(), dtype=np.uint8))
        with open(os.path.join(self.db_path, "index.pkl"), "rb") as f:
            docstore, idx_map = pickle.load(f)

        vs = FAISSStore(embedding_function=emb, index=index, docstore=docstore, index_to_docstore_id=idx_map)
        docs = vs.similarity_search("dougong", k=3)
        assert len(docs) == 3
        assert all(hasattr(d, "page_content") for d in docs)


# ── AI Tools API (Smoke) ────────────────────────────

class TestAIToolsAPI:
    def test_generate_image_endpoint_exists(self):
        r = client.post("/api/v1/ai/generate-image", json={"prompt": "test"})
        # May fail with API error but should not 404
        assert r.status_code != 404

    def test_analyze_image_url_endpoint_exists(self):
        r = client.post("/api/v1/ai/analyze-image-url", json={"image_url": "https://example.com/test.jpg"})
        assert r.status_code != 404


if __name__ == "__main__":
    pytest.main([__file__, "-v", "--tb=short"])
